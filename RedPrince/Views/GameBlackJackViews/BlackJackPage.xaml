<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RedPrince.Views.GameBlackJackViews.BlackJackPage"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <!-- Dealer Section -->
            <StackLayout>
                <Label Text="Dealer" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource SecondaryDarkText}}"/>
                <FlexLayout BindableLayout.ItemsSource="{Binding DealerCards}" Wrap="Wrap" JustifyContent="Start" AlignItems="Start">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Frame Margin="0,0,10,10" BorderColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}" CornerRadius="8" Padding="10" HasShadow="True">
                                <VerticalStackLayout Spacing="5" WidthRequest="60" HeightRequest="90">
                                    <Label Text="{Binding RankDisplay}" FontSize="16" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"/>
                                    <Label Text="{Binding SuitSymbol}" FontSize="20" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"/>
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
                <Label Text="{Binding DealerScore, StringFormat='Score: {0}'}" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray200}}"/>
            </StackLayout>

            <!-- Game Status -->
            <BoxView Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" HeightRequest="1" Margin="0,15"/>

            <Label Text="{Binding StatusMessage}" FontSize="18" TextColor="{AppThemeBinding Light={StaticResource DarkRed}, Dark={StaticResource Red}}" HorizontalOptions="Center" FontAttributes="Bold"/>
            <Label Text="{Binding ResultMessage}" FontSize="22" FontAttributes="Bold" IsVisible="{Binding ResultVisible}" TextColor="{AppThemeBinding Light={StaticResource DarkRed}, Dark={StaticResource Red}}" HorizontalOptions="Center"/>

            <!-- Player Section -->
            <StackLayout>
                <Label Text="Player" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource SecondaryDarkText}}"/>
                <FlexLayout BindableLayout.ItemsSource="{Binding PlayerCards}" Wrap="Wrap" JustifyContent="Start" AlignItems="Start">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Frame Margin="0,0,10,10" BorderColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}" CornerRadius="8" Padding="10" HasShadow="True">
                                <VerticalStackLayout Spacing="5" WidthRequest="60" HeightRequest="90">
                                    <Label Text="{Binding RankDisplay}" FontSize="16" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"/>
                                    <Label Text="{Binding SuitSymbol}" FontSize="20" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"/>
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
                <Label Text="{Binding PlayerScore, StringFormat='Score: {0}'}" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray200}}"/>
            </StackLayout>

            <!-- Betting Section -->
            <Frame IsVisible="{Binding IsBettingPhase}" BackgroundColor="{AppThemeBinding Light=#d1d1d1, Dark=#525252}" Padding="15" CornerRadius="10" HasShadow="False" BorderColor="Transparent">
                <StackLayout Spacing="15">
                    <Grid ColumnDefinitions="*,*">
                        <Label Grid.Column="0" Text="{Binding PlayerBalance, StringFormat='Balance: ${0}'}" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource SecondaryDarkText}}"/>
                        <Label Grid.Column="1" Text="{Binding CurrentBet, StringFormat='Current Bet: ${0}'}" FontSize="16" FontAttributes="Bold" HorizontalTextAlignment="End" TextColor="{AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource SecondaryDarkText}}"/>
                    </Grid>

                    <FlexLayout Wrap="Wrap" JustifyContent="Center" AlignItems="Center" Margin="0,10,0,0">
                        <Button Text="$100" Command="{Binding AddChipCommand}" CommandParameter="100" Margin="5" Padding="10,5" CornerRadius="20" BackgroundColor="#c3c3c3" TextColor="Black" BorderColor="{AppThemeBinding Light=#a1a1a1, Dark=#f5f2f2}" BorderWidth="3" FontAttributes="Bold"/>
                        <Button Text="$500" Command="{Binding AddChipCommand}" CommandParameter="500" Margin="5" Padding="10,5" CornerRadius="20" BackgroundColor="#f53b3b" TextColor="White" BorderColor="{AppThemeBinding Light=#b52b2b, Dark=#f76363}" BorderWidth="3" FontAttributes="Bold"/>
                        <Button Text="$1000" Command="{Binding AddChipCommand}" CommandParameter="1000" Margin="5" Padding="10,5" CornerRadius="20" BackgroundColor="#2e78f0" TextColor="White" BorderColor="{AppThemeBinding Light=#2157ad, Dark=#629bf5}" BorderWidth="3" FontAttributes="Bold"/>
                        <Button Text="$5000" Command="{Binding AddChipCommand}" CommandParameter="5000" Margin="5" Padding="10,5" CornerRadius="20" BackgroundColor="#0aa60a" TextColor="White" BorderColor="{AppThemeBinding Light=#066b06, Dark=#79d979}" BorderWidth="3" FontAttributes="Bold"/>
                        <Button Text="$10000" Command="{Binding AddChipCommand}" CommandParameter="10000" Margin="5" Padding="10,5" CornerRadius="20" BackgroundColor="Black" TextColor="White" BorderColor="#4d4d4d" BorderWidth="3" FontAttributes="Bold"/>
                    </FlexLayout>

                    <HorizontalStackLayout Spacing="20" HorizontalOptions="Center" Margin="0,10,0,0">
                        <Button Text="Clear Bet" Command="{Binding ClearBetCommand}" Padding="20,10" BackgroundColor="{AppThemeBinding Light=#9e9d9d, Dark=#b5b5b5}" TextColor="White" FontAttributes="Bold" CornerRadius="8"/>
                        <Button Text="Deal" Command="{Binding DealCommand}" Padding="30,10" BackgroundColor="{StaticResource Red}" TextColor="White" CornerRadius="8" FontAttributes="Bold"/>
                    </HorizontalStackLayout>
                </StackLayout>
            </Frame>

            <!-- Game Controls -->
            <StackLayout IsVisible="{Binding IsPlayerTurn}" Spacing="10" Padding="10">
                <HorizontalStackLayout Spacing="15" HorizontalOptions="Center">
                    <Button Text="Hit" Command="{Binding HitCommand}" Padding="25,12" BackgroundColor="{StaticResource Red}" CornerRadius="8" FontAttributes="Bold"/>
                    <Button Text="Stand" Command="{Binding StandCommand}" Padding="25,12" BackgroundColor="{AppThemeBinding Light=#9e9d9d, Dark=#b5b5b5}" CornerRadius="8" FontAttributes="Bold"/>
                    <Button Text="Double Down" Command="{Binding DoubleDownCommand}" Padding="20,12" BackgroundColor="Gold" TextColor="#4a4a4a" CornerRadius="8" FontAttributes="Bold"/>
                </HorizontalStackLayout>
            </StackLayout>

            <!-- New Game Button -->
            <Button Text="New Game" Command="{Binding NewGameCommand}" HorizontalOptions="Fill" Margin="20,10" BackgroundColor="{StaticResource Red}" TextColor="{StaticResource White}" CornerRadius="8" FontAttributes="Bold"/>

            <!-- Stats -->
            <Frame BorderColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}" CornerRadius="10" Padding="15" HasShadow="False" Margin="0,10,0,0">
                <StackLayout>
                    <Label Text="Statistics" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center" Margin="0,0,0,10"/>
                    <HorizontalStackLayout Spacing="20" HorizontalOptions="Center">
                        <VerticalStackLayout HorizontalOptions="Center">
                            <Label Text="Wins" FontSize="12" HorizontalTextAlignment="Center"/>
                            <Label Text="{Binding Wins}" FontSize="16" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout HorizontalOptions="Center">
                            <Label Text="Losses" FontSize="12" HorizontalTextAlignment="Center"/>
                            <Label Text="{Binding Losses}" FontSize="16" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout HorizontalOptions="Center">
                            <Label Text="Pushes" FontSize="12" HorizontalTextAlignment="Center"/>
                            <Label Text="{Binding Pushes}" FontSize="16" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </StackLayout>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
